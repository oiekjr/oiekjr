<svg xmlns="http://www.w3.org/2000/svg" width="$width" height="$height" viewBox="0 0 $width $height" role="img" aria-labelledby="title desc">
  <title id="title">$username — GitHub profile</title>
  <desc id="desc">Languages and technologies: Japanese, HTML, CSS, JavaScript, TypeScript, PHP, Node.js, Python and SQL. AI tools: Codex and Claude Code. Public activity in $year — Repositories with commit contributions: $contributed_repositories. Commits: $commits. Pull requests: $pull_requests. Issues: $issues. $updated.</desc>

  <style>
    .count-static { display: none; }
    @media (prefers-reduced-motion: reduce) {
      .orbit-motion, .count-motion { display: none; }
      .count-static { display: inline; }
      .orbit-static { display: inline; }
    }
  </style>
  <defs>
    <path id="orbit-track" d="M90 0 A90 32 0 1 1 -90 0 A90 32 0 1 1 90 0Z"/>
    <g id="orbit-rest">
      <g transform="rotate(-45)">
        <use href="#orbit-track" fill="none" stroke="$text" stroke-width="1.5" stroke-opacity="0.55"/>
        <circle cx="90" r="7" fill="$text"/>
      </g>
      <g transform="rotate(225)">
        <use href="#orbit-track" fill="none" stroke="$text" stroke-width="1.5" stroke-opacity="0.55"/>
        <circle cx="90" r="5" fill="$background" stroke="$text" stroke-width="1.5"/>
      </g>
    </g>
    <rect id="language-tile" width="$chip_width" height="44" rx="8" fill="$surface" stroke="$line" stroke-opacity="0.65"/>
    <g id="tool-terminal" fill="none" stroke="$text" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 9L14 16L7 23 M18 23H26"/>
    </g>
    <g id="tool-spark" fill="none" stroke="$text" stroke-width="1.8" stroke-linecap="round">
      <path d="M16 3V29 M3 16H29 M7 7L25 25 M7 25L25 7"/>
    </g>
    <g id="activity-repo" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 3H19V20H5A3 3 0 0 1 5 14H19 M5 3A3 3 0 0 0 2 6V17 M8 7H14"/>
    </g>
    <g id="activity-commit" fill="none" stroke-width="1.7" stroke-linecap="round">
      <circle cx="11" cy="11" r="4"/><path d="M1 11H7 M15 11H21"/>
    </g>
    <g id="activity-pr" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="5" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="18" cy="19" r="2"/>
      <path d="M5 7V17 M18 17V10A5 5 0 0 0 13 5H11 M14 2L11 5L14 8"/>
    </g>
    <g id="activity-issue" fill="none" stroke-width="1.7" stroke-linecap="round">
      <circle cx="11" cy="11" r="9"/><path d="M11 6V11 M11 15V15.1"/>
    </g>
  </defs>

  <g font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif" fill="$text">
    <g transform="$mark_transform">
      <circle class="orbit-inner" r="53" fill="none" stroke="$text" stroke-opacity="0.85"/>
      <g class="orbit-motion">
        <g transform="rotate(-45)">
          <animateTransform attributeName="transform" type="rotate" values="-45;-40;-48.5;-45" keyTimes="0;0.33;0.67;1" dur="12s" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1" repeatCount="indefinite"/>
          <g>
            <animateTransform attributeName="transform" type="scale" values="1 1;1 0.86;1 1.08;1 1" keyTimes="0;0.33;0.67;1" dur="12s" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1" repeatCount="indefinite"/>
            <use href="#orbit-track" fill="none" stroke="$text" stroke-width="1.5" stroke-opacity="0.55"/>
            <circle r="7" fill="$text">
              <animateMotion dur="12s" repeatCount="indefinite">
                <mpath href="#orbit-track"/>
              </animateMotion>
            </circle>
          </g>
        </g>
        <g transform="rotate(225)">
          <animateTransform attributeName="transform" type="rotate" values="225;221;229.5;225" keyTimes="0;0.33;0.67;1" dur="17s" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1" repeatCount="indefinite"/>
          <g>
            <animateTransform attributeName="transform" type="scale" values="1 1;1 1.08;1 0.86;1 1" keyTimes="0;0.33;0.67;1" dur="17s" calcMode="spline" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1" repeatCount="indefinite"/>
            <use href="#orbit-track" fill="none" stroke="$text" stroke-width="1.5" stroke-opacity="0.55"/>
            <circle r="5" fill="$background" stroke="$text" stroke-width="1.5">
              <animateMotion dur="18.75s" repeatCount="indefinite">
                <mpath href="#orbit-track"/>
              </animateMotion>
            </circle>
          </g>
        </g>
      </g>
      <use class="orbit-static" href="#orbit-rest" display="none"/>
      <circle r="12" fill="$text"/>
    </g>


    <text x="0" y="31" font-size="32" font-weight="600">Profile</text>
    <path d="M0 50.5H$width" stroke="$line" stroke-opacity="0.7"/>

    <text x="0" y="98" font-size="24" font-weight="600">Languages &amp; Tech</text>
    <path d="M0 113.5H$width" stroke="$line" stroke-opacity="0.7"/>
    <g font-family="'SFMono-Regular', Consolas, 'Liberation Mono', monospace" font-size="16" font-weight="500">
      <g transform="$japanese_position"><use href="#language-tile"/><text x="16" y="28">Japanese</text></g>
      <g transform="$html_position"><use href="#language-tile"/><text x="16" y="28">HTML</text></g>
      <g transform="$css_position"><use href="#language-tile"/><text x="16" y="28">CSS</text></g>
      <g transform="$javascript_position"><use href="#language-tile"/><text x="16" y="28">JavaScript</text></g>
      <g transform="$typescript_position"><use href="#language-tile"/><text x="16" y="28">TypeScript</text></g>
      <g transform="$php_position"><use href="#language-tile"/><text x="16" y="28">PHP</text></g>
      <g transform="$node_position"><use href="#language-tile"/><text x="16" y="28">Node.js</text></g>
      <g transform="$python_position"><use href="#language-tile"/><text x="16" y="28">Python</text></g>
      <g transform="$sql_position"><use href="#language-tile"/><text x="16" y="28">SQL</text></g>
    </g>

    <text x="0" y="$ai_heading_y" font-size="24" font-weight="600">AI Tools</text>
    <path d="M0 $ai_rule_y H$width" stroke="$line" stroke-opacity="0.7"/>
    <g transform="translate(0 $tool_y)">
      <rect x="0.5" y="0.5" width="$tool_width" height="$tool_height" rx="10" fill="$surface" stroke="$line" stroke-opacity="0.65"/>
      <g transform="$tool_icon_position"><use href="#tool-terminal"/></g>
      <text x="$tool_text_x" y="$tool_text_y" text-anchor="$tool_text_anchor" font-size="18" font-weight="600">Codex</text>
    </g>
    <g transform="translate($tool_second_x $tool_y)">
      <rect x="0.5" y="0.5" width="$tool_width" height="$tool_height" rx="10" fill="$surface" stroke="$line" stroke-opacity="0.65"/>
      <g transform="$tool_icon_position"><use href="#tool-spark"/></g>
      <text x="$tool_text_x" y="$tool_text_y" text-anchor="$tool_text_anchor" font-size="18" font-weight="600">Claude Code</text>
    </g>

    <text x="0" y="$activity_heading_y" font-size="24" font-weight="600">GitHub Activity · $year</text>
    <path d="M0 $activity_rule_y H$width" stroke="$line" stroke-opacity="0.7"/>
    <g transform="translate(0 $activity_y)">
      <rect width="$width" height="$activity_height" rx="12" fill="$text"/>
      <path d="$activity_dividers" stroke="$inverse_line" stroke-opacity="0.65"/>
      <g transform="$repositories_position">
        <use href="#activity-repo" x="22" y="20" stroke="$inverse_muted"/>
        <g transform="translate(22 82)" fill="$background" font-size="$number_size" font-weight="600" style="font-variant-numeric: tabular-nums">$repositories_count</g>
        <text x="22" y="122" fill="$inverse_muted" font-size="14">Contributed repos</text>
      </g>
      <g transform="$commits_position">
        <use href="#activity-commit" x="22" y="20" stroke="$inverse_muted"/>
        <g transform="translate(22 82)" fill="$background" font-size="$number_size" font-weight="600" style="font-variant-numeric: tabular-nums">$commits_count</g>
        <text x="22" y="122" fill="$inverse_muted" font-size="14">Commits</text>
      </g>
      <g transform="$pull_requests_position">
        <use href="#activity-pr" x="22" y="20" stroke="$inverse_muted"/>
        <g transform="translate(22 82)" fill="$background" font-size="$number_size" font-weight="600" style="font-variant-numeric: tabular-nums">$pull_requests_count</g>
        <text x="22" y="122" fill="$inverse_muted" font-size="14">Pull requests</text>
      </g>
      <g transform="$issues_position">
        <use href="#activity-issue" x="22" y="20" stroke="$inverse_muted"/>
        <g transform="translate(22 82)" fill="$background" font-size="$number_size" font-weight="600" style="font-variant-numeric: tabular-nums">$issues_count</g>
        <text x="22" y="122" fill="$inverse_muted" font-size="14">Issues</text>
      </g>
    </g>
  </g>
</svg>
